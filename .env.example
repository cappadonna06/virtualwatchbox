# Copy this file to .env.local and fill in values. Do NOT commit .env.local.

# Supabase (auth + persistence)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI (used by admin image processing)
OPENAI_API_KEY=

# Cloudflare Worker that aggregates watch RSS feeds (see workers/news-feed/).
# Set this to the deployed Worker URL, e.g. https://vw-news-feed.<subdomain>.workers.dev
NEWS_WORKER_URL=
