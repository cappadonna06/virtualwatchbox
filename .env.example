# Copy this file to .env.local and fill in values. Do NOT commit .env.local.

# Supabase (auth + persistence)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI (used by admin image processing)
OPENAI_API_KEY=

# Cloudflare Worker that aggregates watch RSS feeds (see workers/news-feed/).
# Set this to the deployed Worker URL, e.g. https://vw-news-feed.<subdomain>.workers.dev
NEWS_WORKER_URL=

# thewatchapi.com — used by scripts/fetch-thewatchapi.ts for catalog hydration.
# Sign up at https://www.thewatchapi.com — token is on your dashboard.
# Free tier is 25 calls/day.
THE_WATCH_API_TOKEN=

# LLM extraction — scripts/llm-extract-specs.ts uses one of these to pull
# structured spec fields (watchType, nickname, MSRP, country, finishes,
# claspType, etc.) out of free-text watch_db descriptions. The script
# auto-detects which provider is set; OpenAI is preferred when both exist.
# Optional: extraction step is skipped gracefully if both are unset.
# OPENAI_API_KEY already declared above (used for admin image identify too)
ANTHROPIC_API_KEY=
