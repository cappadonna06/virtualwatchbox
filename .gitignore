# Dependencies
node_modules/

# Next.js
.next/
out/

# Env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# TypeScript
*.tsbuildinfo

# Misc
.DS_Store
*.pem
npm-debug.log*

# External catalog enrichment inputs (Kaggle / WatchSpecs scraped HTML).
# These are large, third-party, and re-downloadable — not committed.
data/external/

# Catalog enrichment output. Regenerated by `npm run catalog:enrich`. The
# enriched JSON for 35k watches is ~65MB; the source-of-truth lives in
# Supabase after `npm run catalog:seed-full`, so the local copy is just a
# build artifact.
data/catalog-enriched*.json
data/catalog-seed-full.csv
data/catalog-seed-1500.csv

# Processed watch images. After `npm run images:upload-storage`, the
# canonical URL points at Supabase Storage — the local PNGs are unused
# in production and ~908MB on disk. Keep them out of git.
#
# manifest.json is the exception: small JSON metadata read by the
# build-time seed (lib/watches.ts → renderableWatches). Must be tracked
# so production's hero pool sees the full set of processed watches.
# Using /* + explicit re-include avoids the "can't re-include after dir
# ignore" gitignore rule.
public/watch-assets/raw/
public/watch-assets/processed/*
public/watch-assets/processed/webp/
!public/watch-assets/processed/manifest.json

# Generated comparison page (one-off output of scripts/build-preview-compare.ts).
public/image-review-preview.html
# Generated tier-batch inspection page (one-off output of scripts/build-tier2-preview.ts).
public/tier2-preview.html
public/watch-assets/processed-preview/

# Claude Code agent runtime state.
.claude/

# CatBoost training scratch (model artifacts, scratch logs).
catboost_info/
