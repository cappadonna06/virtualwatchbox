# External catalog enrichment inputs (Kaggle / WatchSpecs scraped HTML).
# These are large, third-party, and re-downloadable — not committed.
data/external/

# Catalog enrichment output. Regenerated by `npm run catalog:enrich`. The
# enriched JSON for 35k watches is ~65MB; the source-of-truth lives in
# Supabase after `npm run catalog:seed-full`, so the local copy is just a
# build artifact.
data/catalog-enriched*.json
data/catalog-seed-full.csv
data/catalog-seed-1500.csv

# Processed watch images. After `npm run images:upload-storage`, the
# canonical URL points at Supabase Storage — the local PNGs are unused
# in production and ~908MB on disk. Keep them out of git.
public/watch-assets/raw/
public/watch-assets/processed/

# CatBoost training scratch (model artifacts, scratch logs).
catboost_info/
.claude/
